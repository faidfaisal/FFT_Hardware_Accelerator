#! /opt/homebrew/Cellar/icarus-verilog/13.0/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2009.vpi";
S_0x1051a4af0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x1051a4c70 .scope module, "tb_twiddle_rom" "tb_twiddle_rom" 3 3;
 .timescale -9 -12;
P_0x8cc80c500 .param/l "ABITS" 0 3 5, +C4<00000000000000000000000000001001>;
P_0x8cc80c540 .param/l "WIDTH" 0 3 6, +C4<00000000000000000000000000010000>;
v0x1051b0950_0 .var "addr", 8 0;
v0x1051b09f0_0 .var "clk", 0 0;
v0x1051b0a90_0 .net/s "wi", 15 0, v0x1051b0810_0;  1 drivers
v0x1051b0b30_0 .net/s "wr", 15 0, v0x1051b08b0_0;  1 drivers
S_0x1051af8c0 .scope begin, "$ivl_for_loop0" "$ivl_for_loop0" 3 58, 3 58 0, S_0x1051a4c70;
 .timescale -9 -12;
v0x1051a8f20_0 .var/2s "i", 31 0;
E_0x1051a4e40 .event posedge, v0x1051b0630_0;
S_0x1051afa40 .scope module, "dut" "twiddle_rom" 3 19, 4 2 0, S_0x1051a4c70;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 9 "addr";
    .port_info 2 /OUTPUT 16 "wr";
    .port_info 3 /OUTPUT 16 "wi";
P_0x1051afc10 .param/l "ABITS" 0 4 5, +C4<00000000000000000000000000001001>;
P_0x1051afc50 .param/l "DEPTH" 0 4 4, +C4<00000000000000000000001000000000>;
P_0x1051afc90 .param/l "N" 0 4 3, +C4<00000000000000000000010000000000>;
P_0x1051afcd0 .param/l "WIDTH" 0 4 6, +C4<00000000000000000000000000010000>;
v0x1051a8fc0_0 .net "addr", 8 0, v0x1051b0950_0;  1 drivers
v0x1051b0630_0 .net "clk", 0 0, v0x1051b09f0_0;  1 drivers
v0x1051b06d0 .array/s "rom_imag", 511 0, 15 0;
v0x1051b0770 .array/s "rom_real", 511 0, 15 0;
v0x1051b0810_0 .var/s "wi", 15 0;
v0x1051b08b0_0 .var/s "wr", 15 0;
    .scope S_0x1051afa40;
T_0 ;
    %vpi_call/w 4 17 "$readmemh", "twiddle_real.hex", v0x1051b0770 {0 0 0};
    %vpi_call/w 4 18 "$readmemh", "twiddle_imag.hex", v0x1051b06d0 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x1051afa40;
T_1 ;
    %wait E_0x1051a4e40;
    %load/vec4 v0x1051a8fc0_0;
    %pad/u 11;
    %ix/vec4 4;
    %load/vec4a v0x1051b0770, 4;
    %assign/vec4 v0x1051b08b0_0, 0;
    %load/vec4 v0x1051a8fc0_0;
    %pad/u 11;
    %ix/vec4 4;
    %load/vec4a v0x1051b06d0, 4;
    %assign/vec4 v0x1051b0810_0, 0;
    %jmp T_1;
    .thread T_1;
    .scope S_0x1051a4c70;
T_2 ;
    %delay 5000, 0;
    %load/vec4 v0x1051b09f0_0;
    %inv;
    %store/vec4 v0x1051b09f0_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x1051a4c70;
T_3 ;
    %vpi_call/w 3 30 "$dumpfile", "tb_twiddle_rom.vcd" {0 0 0};
    %vpi_call/w 3 31 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x1051a4c70 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1051b09f0_0, 0, 1;
    %pushi/vec4 0, 0, 9;
    %store/vec4 v0x1051b0950_0, 0, 9;
    %wait E_0x1051a4e40;
    %pushi/vec4 0, 0, 9;
    %store/vec4 v0x1051b0950_0, 0, 9;
    %wait E_0x1051a4e40;
    %vpi_call/w 3 39 "$display", "Test 1 - W^0:" {0 0 0};
    %vpi_call/w 3 40 "$display", "  wr = %0d (expect 32767)", v0x1051b0b30_0 {0 0 0};
    %vpi_call/w 3 41 "$display", "  wi = %0d (expect 0)", v0x1051b0a90_0 {0 0 0};
    %wait E_0x1051a4e40;
    %pushi/vec4 256, 0, 9;
    %store/vec4 v0x1051b0950_0, 0, 9;
    %wait E_0x1051a4e40;
    %vpi_call/w 3 46 "$display", "Test 2 - W^256 (should be 0 - j1.0):" {0 0 0};
    %vpi_call/w 3 47 "$display", "  wr = %0d (expect 0)", v0x1051b0b30_0 {0 0 0};
    %vpi_call/w 3 48 "$display", "  wi = %0d (expect -32768)", v0x1051b0a90_0 {0 0 0};
    %wait E_0x1051a4e40;
    %pushi/vec4 128, 0, 9;
    %store/vec4 v0x1051b0950_0, 0, 9;
    %wait E_0x1051a4e40;
    %vpi_call/w 3 53 "$display", "Test 3 - W^128 (should be 0.707 - j0.707):" {0 0 0};
    %vpi_call/w 3 54 "$display", "  wr = %0d (expect ~23170)", v0x1051b0b30_0 {0 0 0};
    %vpi_call/w 3 55 "$display", "  wi = %0d (expect ~-23170)", v0x1051b0a90_0 {0 0 0};
    %vpi_call/w 3 57 "$display", "Test 4 - address sweep:" {0 0 0};
    %fork t_1, S_0x1051af8c0;
    %jmp t_0;
    .scope S_0x1051af8c0;
t_1 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x1051a8f20_0, 0, 32;
T_3.0 ; Top of for-loop
    %load/vec4 v0x1051a8f20_0;
    %cmpi/s 4, 0, 32;
	  %jmp/0xz T_3.1, 5;
    %wait E_0x1051a4e40;
    %load/vec4 v0x1051a8f20_0;
    %pad/s 9;
    %store/vec4 v0x1051b0950_0, 0, 9;
    %wait E_0x1051a4e40;
    %vpi_call/w 3 62 "$display", "  addr=%0d: wr=%0d wi=%0d", v0x1051b0950_0, v0x1051b0b30_0, v0x1051b0a90_0 {0 0 0};
T_3.2 ; for-loop step statement
    ; show_stmt_assign_vector: Get l-value for compressed += operand
    %load/vec4 v0x1051a8f20_0;
    %pushi/vec4 1, 0, 32;
    %add;
    %cast2;
    %store/vec4 v0x1051a8f20_0, 0, 32;
    %jmp T_3.0;
T_3.1 ; for-loop exit label
    %end;
    .scope S_0x1051a4c70;
t_0 %join;
    %vpi_call/w 3 65 "$finish" {0 0 0};
    %end;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "twiddle_romtb.sv";
    "twiddle_rom.sv";
